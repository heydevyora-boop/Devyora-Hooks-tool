# Copy to .env and fill in for your environment. Vite only exposes
# variables prefixed VITE_ to the browser bundle.

# Base URL of the backend API. Defaults to http://localhost:4000/api/v1
# when unset (see src/api/client.ts) — set this explicitly for any
# non-local deployment so the frontend never talks to localhost.
VITE_API_BASE_URL="http://localhost:4000/api/v1"
