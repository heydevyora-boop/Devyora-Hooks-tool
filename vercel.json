{
  "buildCommand": "npm run build && cd backend && npm install && npm run prisma:generate && npm run build",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "backend/node_modules/.prisma/client/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
