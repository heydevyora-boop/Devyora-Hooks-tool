# Copy to .env and fill in real values for your environment.
# .env itself is gitignored — never commit real secrets.

NODE_ENV=development
PORT=4000

# Postgres connection string (Chunk 2 blueprint: Postgres is the primary store)
DATABASE_URL="postgresql://devyora_app:changeme@localhost:5432/devyora_hooks"

# Origin(s) the existing frontend is served from — comma-separated for multiple.
# Vite dev server default is http://localhost:5173
CORS_ORIGIN="http://localhost:5173"

# Signs the session cookie (httpOnly) — generate a long random value per environment.
SESSION_COOKIE_SECRET="change-this-to-a-long-random-string-per-environment"
# Session lifetime in seconds (sliding expiration, see auth architecture doc)
SESSION_TTL_SECONDS=604800

# Local-disk file storage root (dev default). A production deployment swaps
# StorageService's provider for an S3-compatible one without touching callers
# — see src/services/storage.service.ts.
LOCAL_STORAGE_ROOT="./storage/uploads"
# Public base path the API serves uploaded files under
MEDIA_PUBLIC_BASE_PATH="/media/files"

# Max upload size in bytes (default 200MB, matches Chunk 2 blueprint §8)
MAX_UPLOAD_BYTES=209715200

# AES-256-GCM key used to encrypt Instagram OAuth tokens at rest — 32 random
# bytes, hex-encoded (exactly 64 hex characters). Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-this-to-a-generated-64-char-hex-string"

# Official Instagram Business Login / Graph API app credentials — optional.
# Leave unset in dev/test; the integration honestly reports itself as "not
# configured" instead of fabricating connected-account data. See
# src/services/instagram.service.ts.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI="http://localhost:4000/api/v1/integrations/instagram/callback"
