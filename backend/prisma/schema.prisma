// Devyora Hooks — backend schema.
//
// Chunk 3 scope: Users/Roles, Products/Brand/Product Knowledge, Sources,
// Uploaded Files, Historical Content, Content Performance, plus Workspace
// and Session.
//
// Chunk 4 scope (this addition): Instagram integration, Inspiration, Content
// Grids, Content Rules, Admin Approvals, Content Strategy, Content
// Flowchart. Generated content / script versions / AI metrics / content
// calendar / trends / opportunities remain future-chunk scope — still not
// created here, same "don't get ahead of what's actually being built"
// principle as Chunk 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("free")
  seatLimit Int      @default(5) @map("seat_limit")
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  products            Product[]
  brandProfile        BrandProfile?
  mediaAssets         MediaAsset[]
  contentSources      ContentSource[]
  contentHistory      ContentHistory[]
  instagramConnection InstagramConnection?
  inspirationItems    InspirationItem[]
  gridTemplates       GridTemplate[]
  activeGrid          WorkspaceActiveGrid?
  contentRules        ContentRule[]
  pendingApprovals    PendingApproval[]
  contentStrategies   ContentStrategy[]
  contentFlowcharts   ContentFlowchart[]
  generatedContent    GeneratedContent[]
  viralityConfig      ViralityConfig?

  @@map("workspaces")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String    @unique
  username     String
  passwordHash String    @map("password_hash")
  role         Role      @default(USER)
  avatarUrl    String?   @map("avatar_url")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  createdProducts     Product[]                 @relation("ProductCreatedBy")
  uploadedMedia       MediaAsset[]              @relation("MediaUploadedBy")
  addedSources        ContentSource[]           @relation("SourceAddedBy")
  createdHistory      ContentHistory[]          @relation("HistoryCreatedBy")
  connectedInstagram  InstagramConnection[]     @relation("InstagramConnectedBy")
  savedInspiration    InspirationItem[]         @relation("InspirationSavedBy")
  createdGrids        GridTemplate[]            @relation("GridCreatedBy")
  activatedGrids      WorkspaceActiveGrid[]     @relation("GridSetBy")
  createdRules        ContentRule[]             @relation("RuleCreatedBy")
  requestedApprovals  PendingApproval[]         @relation("ApprovalRequestedBy")
  resolvedApprovals   PendingApproval[]         @relation("ApprovalResolvedBy")
  generatedStrategies ContentStrategy[]         @relation("StrategyGeneratedBy")
  approvedFlowcharts  ContentFlowchart[]        @relation("FlowchartApprovedBy")
  generatedContent    GeneratedContent[]        @relation("GeneratedContentGeneratedBy")
  rejectedContent     GeneratedContent[]        @relation("GeneratedContentRejectedBy")
  approvedContent     GeneratedContent[]        @relation("GeneratedContentApprovedBy")
  publishedContent    GeneratedContent[]        @relation("GeneratedContentPublishedBy")
  generatedVersions   GeneratedContentVersion[] @relation("GeneratedContentVersionCreatedBy")
  viralityConfigEdits ViralityConfig[]          @relation("ViralityConfigUpdatedBy")

  @@unique([workspaceId, username])
  @@index([workspaceId])
  @@map("users")
}

/// Server-side session record — the httpOnly cookie carries only this row's
/// id, never user data directly, so a session can be revoked instantly
/// (sign-out, forced logout on role change) by deleting the row. See
/// backend/src/services/auth.service.ts.
model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Brand & Product Knowledge
// ---------------------------------------------------------------------------

/// "Brand information" — one row per workspace. Kept separate from
/// Workspace itself (rather than columns on it) because brand voice is a
/// distinct, independently-editable concern with its own update audit trail.
model BrandProfile {
  id               String    @id @default(uuid())
  workspaceId      String    @unique @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandName        String?   @map("brand_name")
  voiceDescription String?   @map("voice_description") @db.Text
  toneNotes        String?   @map("tone_notes") @db.Text
  bannedPhrases    Json      @default("[]") @map("banned_phrases")
  updatedBy        String?   @map("updated_by")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("brand_profiles")
}

/// "Products" AND "Product Knowledge" are the same entity — see Chunk 2
/// blueprint §1.2: the frontend's own ProductKnowledge type already treats
/// them as one object, so no second table was created to shadow it.
model Product {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String    @default("") @db.Text
  features       Json      @default("[]")
  benefits       Json      @default("[]")
  applications   Json      @default("[]")
  sellingPoints  Json      @default("[]") @map("selling_points")
  targetAudience String    @default("") @map("target_audience")
  limitations    Json      @default("[]")
  contentAngles  Json      @default("[]") @map("content_angles")
  createdBy      String?   @map("created_by")
  createdByUser  User?     @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  contentHistory        ContentHistory[]
  gridSlots             GridSlot[]
  strategySequenceSlots StrategySequenceSlot[]
  flowchartNodes        FlowchartNode[]
  strategyProducts      StrategyProduct[]
  generatedContent      GeneratedContent[]

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Uploaded files & sources
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
  SCREENSHOT
  AUDIO
}

/// "Uploaded files" — the object-storage reference table. See
/// backend/src/services/storage.service.ts for the provider abstraction
/// (local disk now, S3-compatible-ready interface for later).
model MediaAsset {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy       String?   @map("uploaded_by")
  uploadedByUser   User?     @relation("MediaUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)
  /// Source of truth for file location. The URL clients fetch is always
  /// computed (`/media/:id/file`), never stored — avoids a redundant column
  /// that would need updating if the storage provider changes.
  storageKey       String    @unique @map("storage_key")
  mimeType         String    @map("mime_type")
  kind             MediaKind
  fileSizeBytes    Int       @map("file_size_bytes")
  originalFilename String    @map("original_filename")
  createdAt        DateTime  @default(now()) @map("created_at")

  contentSources ContentSource[]

  @@index([workspaceId])
  @@map("media_assets")
}

enum ContentSourceType {
  INSTAGRAM_URL
  YOUTUBE_URL
  WEBSITE_URL
  OTHER_URL
  IMAGE
  VIDEO
  SCREENSHOT
  PDF
  TEXT
  SPEECH
}

enum ContentSourceStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

/// "Sources" — covers every intake type the frontend's SourceImportPanel
/// supports: URLs (Instagram/YouTube/website/other), uploaded files (via
/// MediaAsset), pasted text, and speech-to-text transcripts (the browser's
/// Web Speech API already does the transcription client-side — see Chunk 1
/// §3.12 — so a `SPEECH` source arrives here as plain `value` text, same as
/// `TEXT`, just tagged with its real origin for provenance).
model ContentSource {
  id               String              @id @default(uuid())
  workspaceId      String              @map("workspace_id")
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type             ContentSourceType
  title            String
  value            String              @db.Text
  mediaAssetId     String?             @map("media_asset_id")
  mediaAsset       MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  status           ContentSourceStatus @default(PENDING)
  extractedContent String?             @map("extracted_content") @db.Text
  metadata         Json                @default("{}")
  processingError  String?             @map("processing_error") @db.Text
  addedBy          String?             @map("added_by")
  addedByUser      User?               @relation("SourceAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)
  addedAt          DateTime            @default(now()) @map("added_at")

  inspirationItems InspirationItem[]

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, status])
  @@map("content_sources")
}

// ---------------------------------------------------------------------------
// Historical content & performance
// ---------------------------------------------------------------------------

enum ContentHistoryFormat {
  REEL
  CAROUSEL
  STATIC
  STORY
  VIDEO
}

enum ContentHistoryStatus {
  PUBLISHED
  DRAFT
  SCHEDULED
}

enum ContentHistorySource {
  MANUAL
  INSTAGRAM_SYNC
  GENERATED
}

model ContentHistory {
  id                String               @id @default(uuid())
  workspaceId       String               @map("workspace_id")
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId         String?              @map("product_id")
  product           Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  title             String
  topic             String               @default("")
  format            ContentHistoryFormat
  platform          String               @default("instagram")
  publishedDate     DateTime             @map("published_date")
  hook              String?              @db.Text
  status            ContentHistoryStatus @default(DRAFT)
  source            ContentHistorySource @default(MANUAL)
  performanceLabel  String?              @map("performance_label")
  engagementSummary String?              @map("engagement_summary")
  createdBy         String?              @map("created_by")
  createdByUser     User?                @relation("HistoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  performanceSnapshots ContentPerformance[]
  instagramPost        InstagramPost?
  generatedFrom        GeneratedContent?

  @@index([workspaceId])
  @@index([workspaceId, productId])
  @@index([workspaceId, publishedDate])
  @@index([workspaceId, status])
  @@map("content_history")
}

enum PerformanceSource {
  INSTAGRAM_SYNC
  MANUAL
}

/// Time-series, not a single snapshot column — engagement numbers keep
/// changing after publish, so each sync/manual update appends a row rather
/// than overwriting one. See Chunk 2 blueprint §1.10.
model ContentPerformance {
  id               String            @id @default(uuid())
  contentHistoryId String            @map("content_history_id")
  contentHistory   ContentHistory    @relation(fields: [contentHistoryId], references: [id], onDelete: Cascade)
  capturedAt       DateTime          @default(now()) @map("captured_at")
  views            Int?
  likes            Int?
  shares           Int?
  comments         Int?
  saves            Int?
  engagementRate   Float?            @map("engagement_rate")
  holdRate3s       Float?            @map("hold_rate_3s")
  source           PerformanceSource @default(MANUAL)

  @@index([contentHistoryId, capturedAt])
  @@map("content_performance")
}

// ---------------------------------------------------------------------------
// Instagram Account Intelligence
// ---------------------------------------------------------------------------

enum InstagramConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  SYNCING
  ERROR
}

/// One row per workspace. Official Instagram Business Login / Graph API only
/// — see src/services/instagram.service.ts. No scraping is implemented or
/// planned: when INSTAGRAM_APP_ID/SECRET aren't configured, the service
/// reports that honestly rather than fabricating connected-account data.
model InstagramConnection {
  id                String                    @id @default(uuid())
  workspaceId       String                    @unique @map("workspace_id")
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status            InstagramConnectionStatus @default(NOT_CONNECTED)
  handle            String?
  externalAccountId String?                   @map("external_account_id")
  /// AES-256-GCM ciphertext (see lib/crypto.ts) — never plaintext, never
  /// returned by any API response.
  accessTokenCipher String?                   @map("access_token_cipher") @db.Text
  tokenExpiresAt    DateTime?                 @map("token_expires_at")
  oauthState        String?                   @map("oauth_state")
  followersCount    Int?                      @map("followers_count")
  postsCount        Int?                      @map("posts_count")
  reelsCount        Int?                      @map("reels_count")
  postingFrequency  String?                   @map("posting_frequency")
  lastSyncedAt      DateTime?                 @map("last_synced_at")
  lastSyncError     String?                   @map("last_sync_error") @db.Text
  connectedBy       String?                   @map("connected_by")
  connectedByUser   User?                     @relation("InstagramConnectedBy", fields: [connectedBy], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  posts InstagramPost[]

  @@map("instagram_connections")
}

enum InstagramMediaType {
  REEL
  CAROUSEL
  STATIC
  STORY
}

/// "Instagram content" — synced media, normalized into ContentHistory (see
/// instagram.service.ts#normalizeIntoHistory) rather than being a second,
/// divergent source of truth for what was published.
model InstagramPost {
  id                    String              @id @default(uuid())
  instagramConnectionId String              @map("instagram_connection_id")
  instagramConnection   InstagramConnection @relation(fields: [instagramConnectionId], references: [id], onDelete: Cascade)
  externalPostId        String              @map("external_post_id")
  mediaType             InstagramMediaType  @map("media_type")
  mediaUrl              String?             @map("media_url") @db.Text
  thumbnailUrl          String?             @map("thumbnail_url") @db.Text
  caption               String?             @db.Text
  permalink             String?             @db.Text
  publishedAt           DateTime            @map("published_at")
  syncedAt              DateTime            @default(now()) @map("synced_at")
  contentHistoryId      String?             @unique @map("content_history_id")
  contentHistory        ContentHistory?     @relation(fields: [contentHistoryId], references: [id], onDelete: SetNull)

  @@unique([instagramConnectionId, externalPostId])
  @@index([instagramConnectionId, publishedAt])
  @@map("instagram_posts")
}

// ---------------------------------------------------------------------------
// Inspiration
// ---------------------------------------------------------------------------

/// Pattern fields are NEVER the source's raw content verbatim — they're the
/// user's (or, later, AI-suggested) analysis OF the source: what hook/
/// narrative/visual/CTA pattern it demonstrates. Storing the source content
/// itself lives on the linked ContentSource; this table only ever holds
/// derived pattern notes, so inspiration can never accidentally become
/// copied generated content. See Chunk 1 §3.5.
model InspirationItem {
  id              String        @id @default(uuid())
  workspaceId     String        @map("workspace_id")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentSourceId String        @map("content_source_id")
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  /// { hookPattern, topic, format, narrativeStructure, visualPattern, ctaPattern, contentAngle }
  pattern         Json          @default("{}")
  notes           String?       @db.Text
  savedBy         String?       @map("saved_by")
  savedByUser     User?         @relation("InspirationSavedBy", fields: [savedBy], references: [id], onDelete: SetNull)
  savedAt         DateTime      @default(now()) @map("saved_at")

  @@index([workspaceId])
  @@map("inspiration_items")
}

// ---------------------------------------------------------------------------
// Content Grids
// ---------------------------------------------------------------------------

enum GridSlotContentType {
  REEL
  CAROUSEL
  STATIC
  STORY
  EMPTY
}

model GridTemplate {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?   @db.Text
  isPreset      Boolean   @default(false) @map("is_preset")
  createdBy     String?   @map("created_by")
  createdByUser User?     @relation("GridCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  slots             GridSlot[]
  activeFor         WorkspaceActiveGrid?
  contentStrategies ContentStrategy[]

  @@index([workspaceId])
  @@map("grid_templates")
}

model GridSlot {
  id             String              @id @default(uuid())
  gridTemplateId String              @map("grid_template_id")
  gridTemplate   GridTemplate        @relation(fields: [gridTemplateId], references: [id], onDelete: Cascade)
  position       Int
  contentType    GridSlotContentType @default(EMPTY) @map("content_type")
  productId      String?             @map("product_id")
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  label          String?

  @@unique([gridTemplateId, position])
  @@map("grid_slots")
}

/// Which grid is "active" for the workspace right now — a tiny table
/// instead of a column on Workspace, so activation has its own audit trail
/// (who set it, when) and activating a different grid is a clean insert/
/// update rather than a workspace-table write. "Deactivate" = delete this row.
model WorkspaceActiveGrid {
  workspaceId    String       @id @map("workspace_id")
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  gridTemplateId String       @unique @map("grid_template_id")
  gridTemplate   GridTemplate @relation(fields: [gridTemplateId], references: [id], onDelete: Cascade)
  setBy          String?      @map("set_by")
  setByUser      User?        @relation("GridSetBy", fields: [setBy], references: [id], onDelete: SetNull)
  setAt          DateTime     @default(now()) @map("set_at")

  @@map("workspace_active_grid")
}

// ---------------------------------------------------------------------------
// Knowledge Base: Content Rules & Admin Approvals
// ---------------------------------------------------------------------------

model ContentRule {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category      String
  title         String
  description   String?   @db.Text
  tags          Json      @default("[]")
  isLocked      Boolean   @default(false) @map("is_locked")
  createdBy     String?   @map("created_by")
  createdByUser User?     @relation("RuleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("content_rules")
}

enum ApprovalTargetType {
  PRODUCT
  GRID_TEMPLATE
  INSPIRATION
}

enum ApprovalResolution {
  PENDING
  APPROVED
  REJECTED
}

/// Deleting permanent knowledge (products, grid templates, inspiration) is
/// never immediate — it queues a row here that only an admin can resolve.
/// See Chunk 2 blueprint §1.8 / §2.12.
model PendingApproval {
  id              String             @id @default(uuid())
  workspaceId     String             @map("workspace_id")
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetType      ApprovalTargetType @map("target_type")
  targetId        String             @map("target_id")
  targetLabel     String             @map("target_label")
  requestedBy     String?            @map("requested_by")
  requestedByUser User?              @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  requestedAt     DateTime           @default(now()) @map("requested_at")
  resolvedBy      String?            @map("resolved_by")
  resolvedByUser  User?              @relation("ApprovalResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?          @map("resolved_at")
  resolution      ApprovalResolution @default(PENDING)

  @@index([workspaceId])
  @@index([workspaceId, resolution])
  @@map("pending_approvals")
}

// ---------------------------------------------------------------------------
// Content Strategy & Flowchart (= "Content Plan")
// ---------------------------------------------------------------------------

enum StrategyStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model ContentStrategy {
  id                   String         @id @default(uuid())
  workspaceId          String         @map("workspace_id")
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal                 String
  objective            String?        @db.Text
  durationWeeks        Int            @map("duration_weeks")
  postingFrequency     String         @map("posting_frequency")
  audience             String?        @db.Text
  /// string[] of GridSlotContentType-like values this strategy targets —
  /// a denormalized preference list, not something queried relationally.
  contentTypes         Json           @default("[]") @map("content_types")
  gridTemplateId       String?        @map("grid_template_id")
  gridTemplate         GridTemplate?  @relation(fields: [gridTemplateId], references: [id], onDelete: SetNull)
  startDate            DateTime       @map("start_date")
  endDate              DateTime       @map("end_date")
  status               StrategyStatus @default(DRAFT)
  /// Display strings derived from the Gap Engine at generation time — see
  /// src/services/gapEngine.service.ts. Never hand-authored.
  contentGaps          Json           @default("[]") @map("content_gaps")
  opportunitiesSummary Json           @default("[]") @map("opportunities_summary")
  generatedBy          String?        @map("generated_by")
  generatedByUser      User?          @relation("StrategyGeneratedBy", fields: [generatedBy], references: [id], onDelete: SetNull)
  generatedAt          DateTime       @default(now()) @map("generated_at")

  products         StrategyProduct[]
  sequence         StrategySequenceSlot[]
  flowchart        ContentFlowchart?
  generatedContent GeneratedContent[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("content_strategies")
}

model StrategyProduct {
  strategyId String          @map("strategy_id")
  strategy   ContentStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  productId  String          @map("product_id")
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([strategyId, productId])
  @@map("strategy_products")
}

model StrategySequenceSlot {
  id          String              @id @default(uuid())
  strategyId  String              @map("strategy_id")
  strategy    ContentStrategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  weekLabel   String              @map("week_label")
  productId   String?             @map("product_id")
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  contentType GridSlotContentType @map("content_type")
  reason      String              @db.Text
  position    Int

  flowchartNode FlowchartNode?

  @@index([strategyId])
  @@map("strategy_sequence_slots")
}

enum FlowNodeType {
  START
  ANALYSIS
  GAP
  CONTENT
  DECISION
  END
}

enum FlowNodeStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum FlowNodePriority {
  LOW
  MEDIUM
  HIGH
}

enum FlowNodeEffort {
  LOW
  MEDIUM
  HIGH
}

enum FlowNodeBranch {
  YES
  NO
}

/// = "Content Plan": the strategy's approval state lives here
/// (`approvedAt`/`approvedBy`), not as a separate wrapper entity — see
/// Chunk 2 blueprint §1.6 for why no standalone content_plans table exists.
model ContentFlowchart {
  id             String          @id @default(uuid())
  workspaceId    String          @map("workspace_id")
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  strategyId     String          @unique @map("strategy_id")
  strategy       ContentStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  generatedAt    DateTime        @default(now()) @map("generated_at")
  approvedAt     DateTime?       @map("approved_at")
  approvedBy     String?         @map("approved_by")
  approvedByUser User?           @relation("FlowchartApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  nodes FlowchartNode[]
  edges FlowchartEdge[]

  @@map("content_flowcharts")
}

/// "Current state" and "desired destination" are represented through node
/// `type` (START/ANALYSIS for current state, END for the destination), not
/// separate fields — see the frontend's own FlowNodeType, which this
/// mirrors exactly. "Dependencies" are the FlowchartEdge graph (from->to),
/// not a redundant parallel list — an edge pointing INTO a node already IS
/// that node's dependency.
model FlowchartNode {
  id                     String                @id @default(uuid())
  flowchartId            String                @map("flowchart_id")
  flowchart              ContentFlowchart      @relation(fields: [flowchartId], references: [id], onDelete: Cascade)
  type                   FlowNodeType
  label                  String
  productId              String?               @map("product_id")
  product                Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  dateLabel              String?               @map("date_label")
  contentType            GridSlotContentType?  @map("content_type")
  goal                   String?               @db.Text
  status                 FlowNodeStatus        @default(PENDING)
  priority               FlowNodePriority?
  effort                 FlowNodeEffort?
  reason                 String?               @db.Text
  gridPosition           Int?                  @map("grid_position")
  branch                 FlowNodeBranch?
  strategySequenceSlotId String?               @unique @map("strategy_sequence_slot_id")
  strategySequenceSlot   StrategySequenceSlot? @relation(fields: [strategySequenceSlotId], references: [id], onDelete: SetNull)

  outgoingEdges    FlowchartEdge[]   @relation("EdgeFrom")
  incomingEdges    FlowchartEdge[]   @relation("EdgeTo")
  generatedContent GeneratedContent?

  @@index([flowchartId])
  @@map("flowchart_nodes")
}

model FlowchartEdge {
  id          String           @id @default(uuid())
  flowchartId String           @map("flowchart_id")
  flowchart   ContentFlowchart @relation(fields: [flowchartId], references: [id], onDelete: Cascade)
  fromNodeId  String           @map("from_node_id")
  fromNode    FlowchartNode    @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId    String           @map("to_node_id")
  toNode      FlowchartNode    @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  label       String?

  @@index([flowchartId])
  @@map("flowchart_edges")
}

// ---------------------------------------------------------------------------
// AI Content Generation (Chunk 5)
// ---------------------------------------------------------------------------

/// Draft -> Generated -> Review -> Approved -> Published -> Archived.
/// DRAFT is reserved for a future "save the brief before generating" flow —
/// every row created by the current generate action starts at GENERATED,
/// since generation and persistence happen together. PUBLISHED is the
/// point at which this enters the Historical Content system for real (see
/// GeneratedContent.contentHistoryId).
enum ApprovalStage {
  DRAFT
  GENERATED
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// Mirrors ContentSource's text/speech origin distinction for a
/// regeneration's typed-vs-dictated reason.
enum RegenerationReasonOrigin {
  TEXT
  SPEECH
}

/// The stable identity of one generated piece of content — context links,
/// lifecycle stage, and approval audit trail live here. The actual
/// creative output (hook/script/scenes/caption/etc) lives on
/// GeneratedContentVersion, never here, so regenerating never mutates
/// history — it only ever adds a new version row.
model GeneratedContent {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Set when generated from an approved Content Flowchart node (the
  /// "strategic" path) — @unique because a node produces at most one
  /// generated item. Null for an ad-hoc generation started directly from
  /// Create Script Studio, outside of any plan.
  flowchartNodeId String?          @unique @map("flowchart_node_id")
  flowchartNode   FlowchartNode?   @relation(fields: [flowchartNodeId], references: [id], onDelete: SetNull)
  strategyId      String?          @map("strategy_id")
  strategy        ContentStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  productId       String?          @map("product_id")
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  platform     String  @default("instagram")
  topic        String  @db.Text
  gridPosition Int?    @map("grid_position")
  dateLabel    String? @map("date_label")

  /// User-provided generation brief — real input, surfaced back so it's
  /// clear what the generator was actually asked for.
  userInstructions   String? @map("user_instructions") @db.Text
  /// Which real context sources were actually available and used for this
  /// generation (e.g. ["product","historical_content","grid"]) — never a
  /// fixed list, always what was genuinely found for this workspace.
  contextSourcesUsed Json    @default("[]") @map("context_sources_used")

  stage ApprovalStage @default(GENERATED)

  rejectionReason String?   @map("rejection_reason") @db.Text
  rejectedBy      String?   @map("rejected_by")
  rejectedByUser  User?     @relation("GeneratedContentRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  rejectedAt      DateTime? @map("rejected_at")

  approvedBy     String?   @map("approved_by")
  approvedByUser User?     @relation("GeneratedContentApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt     DateTime? @map("approved_at")

  publishedBy      String?         @map("published_by")
  publishedByUser  User?           @relation("GeneratedContentPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  publishedAt      DateTime?       @map("published_at")
  /// Set at publish time — the ContentHistory row this content became.
  /// "Approved content should enter historical Content Intelligence."
  contentHistoryId String?         @unique @map("content_history_id")
  contentHistory   ContentHistory? @relation(fields: [contentHistoryId], references: [id], onDelete: SetNull)

  generatedBy     String?  @map("generated_by")
  generatedByUser User?    @relation("GeneratedContentGeneratedBy", fields: [generatedBy], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  versions GeneratedContentVersion[]

  @@index([workspaceId])
  @@index([workspaceId, stage])
  @@map("generated_content")
}

/// One row per generation or regeneration — the actual creative output,
/// never overwritten. "Keep previous versions" per the Chunk 5 instructions
/// means literally: this table only ever gets new rows, never updates.
model GeneratedContentVersion {
  id                 String                    @id @default(uuid())
  generatedContentId String                    @map("generated_content_id")
  generatedContent   GeneratedContent          @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)
  version            Int
  parentVersionId    String?                   @map("parent_version_id")
  parentVersion      GeneratedContentVersion?  @relation("VersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions      GeneratedContentVersion[] @relation("VersionParent")

  /// The selected hook's text/angle, denormalized from `hooks` for direct
  /// querying (e.g. by the similarity service) without parsing JSON.
  hook   String @db.Text
  angle  String
  /// Synthesized from the scene dialogue — a real derivation of `scenes`,
  /// not a separately-authored field.
  script String @db.Text

  /// HookVariation[] — all offered hook options, one marked selected.
  hooks           Json   @default("[]")
  /// DirectorScene[]
  scenes          Json   @default("[]")
  /// VisualDirectionBeat[]
  visualDirection Json   @default("[]") @map("visual_direction")
  /// BRollShot[]
  brollPlan       Json   @default("[]") @map("broll_plan")
  /// string[]
  onScreenText    Json   @default("[]") @map("on_screen_text")
  cta             String @db.Text
  caption         String @db.Text

  /// Real, non-guaranteed overlap findings against Historical Content and
  /// other generated content in this workspace — see similarity.service.ts.
  similarityWarnings Json @default("[]") @map("similarity_warnings")

  /// Set only on a version produced by regeneration (version > 1).
  regenerationReason       String?                   @map("regeneration_reason") @db.Text
  regenerationReasonOrigin RegenerationReasonOrigin? @map("regeneration_reason_origin")
  regenerationTarget       String?                   @map("regeneration_target")

  createdBy     String?  @map("created_by")
  createdByUser User?    @relation("GeneratedContentVersionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")

  blueprintScore VideoBlueprintScore?

  @@unique([generatedContentId, version])
  @@index([generatedContentId])
  @@map("generated_content_versions")
}

/// Analytical assessment of one version's content, computed at
/// generation/regeneration time — NEVER a guaranteed prediction of future
/// performance. See video_blueprint.service.ts for how each score is
/// derived from real, inspectable signals.
model VideoBlueprintScore {
  id                        String                  @id @default(uuid())
  generatedContentVersionId String                  @unique @map("generated_content_version_id")
  generatedContentVersion   GeneratedContentVersion @relation(fields: [generatedContentVersionId], references: [id], onDelete: Cascade)

  viralityPotential Int    @map("virality_potential")
  tierLabel         String @map("tier_label")
  tierBadge         String @map("tier_badge")
  diagnosis         String @db.Text

  hookStrength       Int @map("hook_strength")
  retentionPotential Int @map("retention_potential")
  specificity        Int
  authority          Int
  brandFit           Int @map("brand_fit")
  naturalSpeech      Int @map("natural_speech")
  ctaClarity         Int @map("cta_clarity")
  visualPotential    Int @map("visual_potential")
  /// Higher = cleaner / less generic-AI-sounding (matches the frontend's
  /// existing "Generic AI ... Clean" convention).
  genericAiScore     Int @map("generic_ai_score")

  /// The ViralityConfig values in effect when this was scored, snapshotted
  /// so an old score is never silently reinterpreted under a later
  /// threshold change.
  viralityMetricLabel String @map("virality_metric_label")
  viralityThreshold   Int    @map("virality_threshold")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("video_blueprint_scores")
}

/// Admin-configurable definition of "viral" for this workspace — one row
/// per workspace, matching the frontend's ViralitySettings type exactly.
/// Never represented as a guaranteed prediction, only a labeling threshold.
model ViralityConfig {
  workspaceId   String    @id @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metricLabel   String    @default("Organic Views") @map("metric_label")
  threshold     Int       @default(50000)
  updatedBy     String?   @map("updated_by")
  updatedByUser User?     @relation("ViralityConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("virality_configs")
}
